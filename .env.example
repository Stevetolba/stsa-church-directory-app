# Copy to .env.local — never commit .env.local

# Subsplash — server-only service credentials (client_credentials grant)
# SUBSPLASH_USE_MOCK: "true" (default) serves lib/mockData.ts fixtures instead
# of calling Subsplash — flip to "false" only once wiring the real API (ADR-0004).
SUBSPLASH_USE_MOCK=true
SUBSPLASH_BASE_URL=https://core.subsplash.com
SUBSPLASH_ORG_KEY=your_org_key_here
SUBSPLASH_CLIENT_ID=your_client_id_here
SUBSPLASH_CLIENT_SECRET=your_client_secret_here
# ADR-0010: name of the Subsplash custom field that grants a personal-email
# volunteer read-only access. Optional — defaults to "Directory Access".
# Church admins set this field to "Yes" on an approved volunteer's profile.
# SUBSPLASH_ACCESS_FIELD_NAME=Directory Access
# ADR-0017: name of the Subsplash custom field (dropdown: Admin / Team Lead /
# Volunteer) that elevates a personal-email person beyond the default
# volunteer tier. Optional — defaults to "DirectoryRole".
# SUBSPLASH_ROLE_FIELD_NAME=DirectoryRole

# Staff auth — Google Workspace SSO via Auth.js (NextAuth v5)
# ADR-001: separate from Subsplash, restricted to the church's Workspace domain.
# ADR-0010: volunteers sign in with a personal Google account and get read-only
# access if flagged via the Subsplash custom field above.
AUTH_SECRET=a_random_32_char_string_for_signing
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
CHURCH_GOOGLE_WORKSPACE_DOMAIN=gracechapel.org
# Auth.js only trusts the request Host when it knows the deployment is safe.
# Vercel is auto-detected, but set this to "true" for any other host (or a
# local production build via `next start`), otherwise every page 500s with
# UntrustedHost. Add the production callback URL
# https://<your-domain>/api/auth/callback/google to the Google OAuth client.
AUTH_TRUST_HOST=true

# Roles — ADR-002: admin emails, comma-separated, resolved by lib/roles.ts
ADMIN_EMAILS=pastor@gracechapel.org,office@gracechapel.org

# Email — Resend (ADR-0014), used by the Children page's "Email Parents"
# feature. RESEND_API_KEY: server-only, from resend.com. Leave unset for
# local dev — sends are logged to the console instead of actually going out,
# mirroring SUBSPLASH_USE_MOCK's mock-by-default approach.
RESEND_API_KEY=your_resend_api_key_here
# Must be on a domain verified with Resend. The signed-in staff/volunteer's
# name becomes the display name and their email becomes Reply-To, so replies
# go to them, not this address.
EMAIL_FROM_ADDRESS=notifications@gracechapel.org

# Attendance / check-in store — Neon Postgres (ADR-0015). Provision via the
# Vercel Neon Marketplace integration (injects DATABASE_URL automatically in
# prod) or a Neon dev branch locally. Leave UNSET for local dev: check-ins
# then live in an in-memory store seeded from lib/mockData.ts, mirroring
# SUBSPLASH_USE_MOCK's mock-by-default approach. Apply migrations with
# `nvm use 24 && npm run db:migrate`.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Attendance import (ADR-0021) — attendance is captured in Subsplash Check-In
# and pulled in via POST /api/attendance/import, by one of two scripts:
#   scripts/sync-subsplash-attendance.ts       manual — you export a CSV by
#                                               hand and point the script at it
#   scripts/scheduled-sync-subsplash.ts        automated — opens the
#                                               dashboard itself and fetches
#                                               every check-in-enabled
#                                               series' export; run on a
#                                               schedule via a local launchd
#                                               job (scripts/run-scheduled-sync-local.sh),
#                                               NOT GitHub Actions — see
#                                               that script's comments and
#                                               ADR-0021 for why a cloud
#                                               runner doesn't work here
#                                               (Subsplash rejects both a
#                                               fresh login and a saved
#                                               session from an unrecognized
#                                               machine/network).
# None of these are used by the Next.js app itself — only by the scripts, and
# only APP_BASE_URL/ATTENDANCE_IMPORT_TOKEN below matter for the deployed app
# (they authorize the import endpoint scripts running elsewhere POST to).

# Authorizes the import endpoint for a script (which has no user session);
# generate a long random string, e.g. `openssl rand -hex 32`. An admin's own
# signed-in session also authorizes the route, so this is only required for
# running a script unattended. Set the SAME value here and wherever the
# scripts run (e.g. scripts/.sync-local.env locally — see its own .example).
# ATTENDANCE_IMPORT_TOKEN=a_random_hex_string_shared_with_the_sync_scripts

# The app's own URL a script POSTs to, and the org's IANA timezone for
# interpreting the export's local check-in times. Only relevant where the
# scripts actually run — not needed by the deployed app itself.
# APP_BASE_URL=https://directory.gracechapel.org
# ORG_TIMEZONE=America/New_York

# scripts/scheduled-sync-subsplash.ts's dashboard auth is entirely local —
# see scripts/capture-subsplash-session.ts (creates a persistent Chrome
# profile at scripts/.subsplash-profile/, read automatically) and
# scripts/.sync-local.env.example. Nothing to set here.

NEXT_PUBLIC_APP_NAME=STSA Church Directory
