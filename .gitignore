# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# next-pwa generated service worker (built at compile time)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js
/public/fallback-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# claude code — personal/local settings, not shared
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# native (Capacitor, ADR-0019) — Brother's BRLMPrinterKit.xcframework is a
# proprietary binary downloaded separately from their developer portal
# (see ios/LocalPackages/BRLMPrinterKit/Package.swift), not ours to
# redistribute; everything else here is generated/local build output.
ios/LocalPackages/BRLMPrinterKit/Sources/*.xcframework
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/**/xcuserdata/
ios/**/.swiftpm/
android/.gradle/
android/app/build/
android/build/
android/local.properties
