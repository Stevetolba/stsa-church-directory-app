# Copy to scripts/.sync-local.env (gitignored — never commit it) and fill in.
# Used by scripts/run-scheduled-sync-local.sh, the launchd-scheduled runner
# (ADR-0021). Dashboard auth isn't set here — it's read fresh from the
# persistent Chrome profile at scripts/.subsplash-profile/ on every run
# instead; see scripts/capture-subsplash-session.ts.

APP_BASE_URL=https://directory.gracechapel.org
ATTENDANCE_IMPORT_TOKEN=a_random_hex_string_shared_with_the_sync_scripts

# Optional — defaults shown.
# ORG_TIMEZONE=America/New_York
# SYNC_LOOKBACK_DAYS=14
